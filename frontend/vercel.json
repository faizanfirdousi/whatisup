{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?p=/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/proxy?p=/auth/:path*"
    },
    {
      "source": "/health",
      "destination": "/api/proxy?p=/health"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/proxy?p=/admin/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
