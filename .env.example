# Database
DATABASE_URL=postgresql+asyncpg://whatisup:whatisup@localhost:5432/whatisup

# GitHub — generate at https://github.com/settings/tokens (classic, scopes: public_repo, read:user)
GITHUB_TOKEN=ghp_your_token_here

# OpenRouter — get free key at https://openrouter.ai/keys (no credit card needed)
OPENROUTER_API_KEY=sk-or-your_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Admin secret — protect admin endpoints (set to any random string)
ADMIN_SECRET=change-me-to-something-random
